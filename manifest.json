{
  "manifest_version": 3,
  "name": "Buttonizer",
  "version": "0.0.1",
  "description": "Scan the current page for buttons, inspect their visual styles, and save them to a private local library.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Buttonizer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ]
}